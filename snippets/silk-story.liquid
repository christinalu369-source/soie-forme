{% comment %}
  SILK STORY — shared markup for every story-driven page.

  Rendered by both `section-silk-story` (the homepage) and
  `section-forme-story` (the Forme side page), each passing its own
  `section` so blocks and settings stay independent per page.

  Usage: {% render 'silk-story', section: section %}
{% endcomment %}

{% comment %}
  A STORY IN SILK — the homepage story experience.

  Structure (ported from prototypes/silk-story.html):
  - `deck`  — fixed, full-viewport; every scene stacks here and cross-fades
  - `track` — invisible; its height is what gives the page scroll length
  - `film`  — progress ticks, one per scene

  The cross-fade is driven by scroll position in section-silk-story.js.
  Scenes are rendered server-side (not built in JS) so the copy is real
  content for search engines and readable with JavaScript disabled.
{% endcomment %}

{%- comment -%} The filmstrip overlays the bottom of the screen, so the band needs clearance {%- endcomment -%}
{%- assign has_film = false -%}
{%- if section.settings.show_filmstrip and section.blocks.size > 1 -%}
  {%- assign has_film = true -%}
{%- endif -%}

<div class="silk-story{% if has_film %} silk-story--has-film{% endif %}{% if section.settings.sidetab_url != blank %} silk-story--has-sidetab{% endif %}">

  <!-- ── DECK: all scenes stack and cross-fade here ── -->
  <div class="silk-story__deck">
    {%- for block in section.blocks -%}

      {%- if block.type == 'hero' -%}
        {%- comment -%}
          Cover screen: full-bleed silk in motion under a scrim, type over it.
          Treatment A from prototypes/hero-options.html.
        {%- endcomment -%}
        {%- assign hero_from = block.settings.color_from | default: '#E7C9D0' -%}
        {%- assign hero_to   = block.settings.color_to   | default: '#7A4A3C' -%}
        {%- assign hero_alt  = block.settings.image.alt  | default: shop.name -%}
        <div
          class="silk-story__scene silk-story__scene--hero"
          style="--scene-from: {{ hero_from }}; --scene-to: {{ hero_to }};"
          {{ block.shopify_attributes }}
        >
          <div class="silk-story__hero-media">
            <div class="silk-story__hero-media-inner">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                      class: 'silk-story__image',
                      loading: 'eager',
                      fetchpriority: 'high',
                      sizes: '100vw',
                      widths: '800, 1200, 1600, 2000, 2400',
                      alt: hero_alt
                }}
              {%- endif -%}
            </div>
            <div class="silk-story__sheen" aria-hidden="true"></div>
          </div>
          <div class="silk-story__scrim" aria-hidden="true"></div>

          <div class="silk-story__hero-content">
            {%- if block.settings.eyebrow != blank -%}
              <p class="silk-story__eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}

            <h1 class="silk-story__hero-mark">{{ block.settings.mark }}</h1>

            {%- if block.settings.sub != blank -%}
              <p class="silk-story__hero-sub">{{ block.settings.sub }}</p>
            {%- endif -%}

            {%- comment -%}
              The cover CTA usually sends people deeper into the story rather
              than off to the collection, so `scroll` is the default action.
            {%- endcomment -%}
            {%- if block.settings.cta_label != blank -%}
              {%- if block.settings.cta_action == 'gallery' -%}
                {%- comment -%} Opens the cover's own collage, without leaving the screen {%- endcomment -%}
                <button
                  type="button"
                  class="silk-story__pill"
                  data-opens-gallery="{{ block.id }}"
                  aria-haspopup="dialog"
                >
                  {{ block.settings.cta_label }} <span aria-hidden="true">&#8594;</span>
                </button>
              {%- else -%}
                {%- if block.settings.cta_action == 'link' -%}
                  {%- assign hero_cta_href = block.settings.cta_url | default: routes.collections_url -%}
                {%- else -%}
                  {%- assign target_scene = block.settings.cta_scene | default: 2 -%}
                  {%- assign hero_cta_href = '#silk-story-scene-' | append: target_scene -%}
                {%- endif -%}
                <a class="silk-story__pill" href="{{ hero_cta_href }}">
                  {{ block.settings.cta_label }} <span aria-hidden="true">&#8594;</span>
                </a>
              {%- endif -%}
            {%- endif -%}
          </div>

          {%- comment -%}
            Sideways cue to the sister site, using the section's Sister site
            link so there is one source of truth with the edge tab.
          {%- endcomment -%}
          {%- if block.settings.show_side_hint and section.settings.sidetab_url != blank -%}
            {%- assign hint_side = section.settings.sidetab_side | default: 'right' -%}
            <a class="silk-story__side-hint silk-story__side-hint--{{ hint_side }}" href="{{ section.settings.sidetab_url }}">
              {%- if hint_side == 'left' -%}
                <span class="silk-story__side-hint-arrow" aria-hidden="true">&#8592;</span>
                <span>{{ section.settings.sidetab_label }}</span>
              {%- else -%}
                <span>{{ section.settings.sidetab_label }}</span>
                <span class="silk-story__side-hint-arrow" aria-hidden="true">&#8594;</span>
              {%- endif -%}
            </a>
          {%- endif -%}

          <div class="silk-story__scroll-hint" aria-hidden="true">
            Scroll <span>&#8595;</span>
          </div>
        </div>

      {%- elsif block.type == 'card' -%}
        {%- comment -%} Opening / closing beats: centred type on a warm field {%- endcomment -%}
        <div
          class="silk-story__scene silk-story__scene--card{% unless forloop.first %} silk-story__scene--closing{% endunless %}"
          {{ block.shopify_attributes }}
        >
          <div class="silk-story__media"></div>
          <div>
            <div class="silk-story__mark">{{ block.settings.mark }}</div>

            {%- if block.settings.sub != blank -%}
              <p class="silk-story__sub">{{ block.settings.sub }}</p>
            {%- endif -%}

            {%- if block.settings.cta_label != blank -%}
              <a
                class="silk-story__cta"
                href="{{ block.settings.cta_url | default: routes.collections_url }}"
              >
                {{ block.settings.cta_label }}
              </a>

              {%- comment -%} Secondary ways out of the story {%- endcomment -%}
              {%- if block.settings.link_1_label != blank or block.settings.link_2_label != blank -%}
                <div class="silk-story__links">
                  {%- if block.settings.link_1_label != blank -%}
                    <a class="silk-story__link" href="{{ block.settings.link_1_url | default: '/' }}">{{ block.settings.link_1_label }}</a>
                  {%- endif -%}
                  {%- if block.settings.link_2_label != blank -%}
                    <a class="silk-story__link" href="{{ block.settings.link_2_url | default: '/' }}">{{ block.settings.link_2_label }}</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- else -%}
              <div class="silk-story__scroll-hint" aria-hidden="true">
                Scroll <span>&#8595;</span>
              </div>
            {%- endif -%}
          </div>
        </div>

      {%- else -%}
        {%- comment -%} Story scene: full-bleed media + caption band {%- endcomment -%}
        {%- assign piece = block.settings.product -%}
        {%- assign scene_alt = block.settings.image.alt | default: block.settings.line -%}
        {%- comment -%}
          Colour fallbacks are inlined with defaults: an empty custom property
          is invalid at computed-value time and would kill the gradient.
        {%- endcomment -%}
        {%- assign wash_from = block.settings.color_from | default: '#EFEADF' -%}
        {%- assign wash_to   = block.settings.color_to   | default: '#A49A80' -%}
        <div
          class="silk-story__scene"
          style="--scene-from: {{ wash_from }}; --scene-to: {{ wash_to }};"
          {{ block.shopify_attributes }}
        >
          <div class="silk-story__media">
            {%- comment -%}
              Video wins over a still when both are set. Built by hand rather
              than with `video_tag` so we control preload and playsinline —
              iOS refuses inline playback without that attribute. Playback is
              started/stopped by the scroll engine, never autoplayed off-screen.
            {%- endcomment -%}
            {%- if block.settings.video != blank -%}
              <video
                class="silk-story__video"
                loop
                muted
                playsinline
                preload="none"
                {% if block.settings.image != blank %}poster="{{ block.settings.image | image_url: width: 1600 }}"{% elsif block.settings.video.preview_image %}poster="{{ block.settings.video.preview_image | image_url: width: 1600 }}"{% endif %}
                aria-label="{{ block.settings.line | escape }}"
              >
                {%- for source in block.settings.video.sources -%}
                  {%- if source.format == 'mp4' or source.format == 'webm' -%}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {%- endif -%}
                {%- endfor -%}
              </video>
            {%- elsif block.settings.image != blank -%}
              {%- comment -%} First scene loads eagerly; the rest wait until near view {%- endcomment -%}
              {%- if forloop.index <= 2 -%}
                {%- assign loading_mode = 'eager' -%}
              {%- else -%}
                {%- assign loading_mode = 'lazy' -%}
              {%- endif -%}
              {{
                block.settings.image
                | image_url: width: 2000
                | image_tag:
                    class: 'silk-story__image',
                    loading: loading_mode,
                    sizes: '100vw',
                    widths: '600, 900, 1200, 1600, 2000',
                    alt: scene_alt
              }}
            {%- endif -%}
          </div>

          <div class="silk-story__band">
            {%- if block.settings.chapter != blank -%}
              <span class="silk-story__chapter">{{ block.settings.chapter }}</span>
            {%- endif -%}

            <h2 class="silk-story__line">{{ block.settings.line }}</h2>

            {%- if block.settings.note != blank -%}
              <p class="silk-story__note">{{ block.settings.note }}</p>
            {%- endif -%}

            {%- comment -%}
              Optional photo collage. Opens a lightbox so the scene's video can
              show one or two ways in motion while the stills carry the rest.
            {%- endcomment -%}
            {%- if block.settings.gallery_label != blank and block.settings.gallery_1 != blank -%}
              <button
                type="button"
                class="silk-story__shop silk-story__shop--ghost"
                data-opens-gallery="{{ block.id }}"
                aria-haspopup="dialog"
              >
                <span class="silk-story__shop-label">{{ block.settings.gallery_label }}</span>
                <span class="silk-story__arrow" aria-hidden="true">&#8594;</span>
              </button>
            {%- endif -%}

            {%- comment -%}
              Soft commerce. A single-variant product adds straight to the cart;
              anything with options (or sold out) links to the product page so
              the customer picks the variant properly.
            {%- endcomment -%}
            {%- if piece != blank -%}
              {%- if piece.available and piece.variants.size == 1 -%}
                <button
                  type="button"
                  class="silk-story__shop"
                  data-variant-id="{{ piece.selected_or_first_available_variant.id }}"
                  data-product-title="{{ piece.title | escape }}"
                >
                  <span class="silk-story__shop-label">Shop this piece &middot; {{ piece.price | money }}</span>
                  <span class="silk-story__arrow" aria-hidden="true">&#8594;</span>
                </button>
              {%- else -%}
                <a class="silk-story__shop" href="{{ piece.url }}">
                  <span class="silk-story__shop-label">
                    {%- if piece.available -%}
                      Shop this piece &middot; {{ piece.price | money }}
                    {%- else -%}
                      View this piece
                    {%- endif -%}
                  </span>
                  <span class="silk-story__arrow" aria-hidden="true">&#8594;</span>
                </a>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

    {%- endfor -%}
  </div><!-- /deck -->


  <!-- ── TRACK: invisible; supplies scroll length and snap points ── -->
  <div class="silk-story__track" aria-hidden="true">
    {%- for block in section.blocks -%}
      <div class="silk-story__step" id="silk-story-scene-{{ forloop.index }}"></div>
    {%- endfor -%}
  </div>


  <!-- ── FILMSTRIP PROGRESS ── -->
  {%- if has_film -%}
    <nav class="silk-story__film" aria-label="Story progress">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="silk-story__tick"
          aria-label="Go to scene {{ forloop.index }} of {{ section.blocks.size }}"
        ></button>
      {%- endfor -%}
    </nav>
  {%- endif -%}


  <!-- ── SIDE TAB: sister site ──
       A pull toward Forme by Soie, sitting on the right edge. The swipe
       gesture in the JS targets this same href. -->
  {%- if section.settings.sidetab_url != blank -%}
    {%- assign tab_side = section.settings.sidetab_side | default: 'right' -%}
    <a
      class="silk-story__sidetab silk-story__sidetab--{{ tab_side }}"
      href="{{ section.settings.sidetab_url }}"
      data-sidetab
      data-sidetab-side="{{ tab_side }}"
      {% if section.settings.sidetab_swipe %}data-sidetab-swipe{% endif %}
    >
      <span class="silk-story__sidetab-label">{{ section.settings.sidetab_label }}</span>
      <span class="silk-story__sidetab-arrow" aria-hidden="true">{% if tab_side == 'left' %}&#8592;{% else %}&#8594;{% endif %}</span>
    </a>
  {%- endif -%}


  <!-- ── PHOTO COLLAGE LIGHTBOXES ──
       Rendered outside the deck so they are never made inert when their
       scene fades out. -->
  {%- for block in section.blocks -%}
    {%- if block.settings.gallery_1 != blank or block.settings.cta_action == 'gallery' -%}
      <div class="silk-story__gallery" data-gallery="{{ block.id }}" hidden>
        <div class="silk-story__gallery-scrim" data-closes-gallery></div>

        <div
          class="silk-story__gallery-panel"
          role="dialog"
          aria-modal="true"
          aria-labelledby="gallery-title-{{ block.id }}"
        >
          <button type="button" class="silk-story__gallery-close" data-closes-gallery aria-label="Close">&times;</button>

          {%- assign gallery_eyebrow = block.settings.gallery_eyebrow | default: block.settings.chapter -%}
          {%- assign gallery_title   = block.settings.gallery_title   | default: block.settings.line -%}
          {%- if gallery_eyebrow != blank -%}
            <p class="silk-story__gallery-eyebrow">{{ gallery_eyebrow }}</p>
          {%- endif -%}
          <h3 class="silk-story__gallery-title" id="gallery-title-{{ block.id }}">{{ gallery_title }}</h3>

          <div class="silk-story__collage">
            {%- for i in (1..6) -%}
              {%- assign img_key = 'gallery_' | append: i -%}
              {%- assign cap_key = 'gallery_' | append: i | append: '_caption' -%}
              {%- assign shot    = block.settings[img_key] -%}
              {%- assign caption = block.settings[cap_key] -%}
              {%- if shot != blank -%}
                <figure class="silk-story__collage-item">
                  {{
                    shot
                    | image_url: width: 900
                    | image_tag:
                        class: 'silk-story__collage-image',
                        loading: 'lazy',
                        sizes: '(min-width: 700px) 30vw, 45vw',
                        widths: '300, 500, 700, 900',
                        alt: caption
                  }}
                  {%- if caption != blank -%}
                    <figcaption class="silk-story__collage-caption">{{ caption }}</figcaption>
                  {%- endif -%}
                </figure>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if block.settings.gallery_1 == blank and request.design_mode -%}
            {%- comment -%} design_mode is true only in the theme editor {%- endcomment -%}
            <p class="silk-story__gallery-empty">
              No photos yet — add them under “Photo collage” in this block’s settings.
            </p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}


  <!-- ── TOAST: add-to-cart confirmation ── -->
  <div class="silk-story__toast" role="status" aria-live="polite"></div>

</div><!-- /silk-story -->
