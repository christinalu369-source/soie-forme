{%- liquid
  assign bg_image = section.settings.background_image
  assign tagline   = section.settings.tagline
-%}

<div
  class="entry"
  {%- if bg_image != blank -%}
    style="background-image:
      radial-gradient(ellipse at center, transparent 30%, rgba(44,44,42,0.45) 100%),
      url('{{ bg_image | image_url: width: 2400 }}');"
  {%- endif -%}
>

  <!-- ── CENTERED CONTENT ── -->
  <div class="entry-center">

    <!-- Logo + tagline -->
    <div class="entry-head">
      <div class="entry-logo">
        Soie <span class="amp">&amp;</span> Forme
      </div>
      <p class="entry-tagline">{{ tagline }}</p>
    </div>

    <!-- Animated structural diagram -->
    <div class="entry-diagram">

      <!-- Vertical stem grows down from logo -->
      <div class="diagram-stem"></div>

      <!-- Horizontal crossbar grows outward from center -->
      <div class="diagram-crossbar">
        <div class="crossbar-half crossbar-left"></div>
        <div class="crossbar-half crossbar-right"></div>
      </div>

      <!-- Four columns: drop line → box -->
      <div class="diagram-nav">

        <!-- Shop → navigates to collections -->
        <div class="nav-col">
          <div class="nav-drop"></div>
          <a
            href="{{ routes.collections_url }}"
            class="nav-box nav-box--shop"
          >
            <span class="shop-arrow">→</span>Shop
          </a>
        </div>

        <!-- Our Story → opens modal -->
        <div class="nav-col">
          <div class="nav-drop"></div>
          <button
            class="nav-box"
            data-opens-modal="story"
            aria-haspopup="dialog"
            aria-controls="modal-story"
          >
            Our Story
          </button>
        </div>

        <!-- Styling Inspo → opens modal -->
        <div class="nav-col">
          <div class="nav-drop"></div>
          <button
            class="nav-box"
            data-opens-modal="styling"
            aria-haspopup="dialog"
            aria-controls="modal-styling"
          >
            Styling Inspo
          </button>
        </div>

        <!-- Contact → opens modal -->
        <div class="nav-col">
          <div class="nav-drop"></div>
          <button
            class="nav-box"
            data-opens-modal="contact"
            aria-haspopup="dialog"
            aria-controls="modal-contact"
          >
            Contact
          </button>
        </div>

      </div><!-- /diagram-nav -->
    </div><!-- /entry-diagram -->

  </div><!-- /entry-center -->


  <!-- ── OVERLAY ── -->
  <div class="modal-overlay" id="modal-overlay" aria-hidden="true"></div>


  <!-- ── MODAL: OUR STORY ── -->
  <div
    class="modal"
    id="modal-story"
    data-modal-id="story"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-story-title"
  >
    <button class="modal-close" aria-label="Close">&times;</button>
    <p class="modal-eyebrow">{{ section.settings.story_eyebrow }}</p>
    <h2 class="modal-title" id="modal-story-title">{{ section.settings.story_title }}</h2>
    <div class="modal-body">{{ section.settings.story_body }}</div>
    {%- if section.settings.story_cta_label != blank -%}
      <a
        href="{{ section.settings.story_cta_url | default: '/pages/about' }}"
        class="modal-cta"
      >
        <span>{{ section.settings.story_cta_label }}</span>
      </a>
    {%- endif -%}
  </div>


  <!-- ── MODAL: STYLING INSPO ── -->
  <div
    class="modal"
    id="modal-styling"
    data-modal-id="styling"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-styling-title"
  >
    <button class="modal-close" aria-label="Close">&times;</button>
    <p class="modal-eyebrow">{{ section.settings.styling_eyebrow }}</p>
    <h2 class="modal-title" id="modal-styling-title">{{ section.settings.styling_title }}</h2>
    <div class="modal-body modal-body--tight">{{ section.settings.styling_intro }}</div>

    {% comment %}
      Four styling methods, each a name + short how-to. Numbering is generated
      by CSS counter so the merchant only edits the copy.
    {% endcomment %}
    <ol class="styling-list">
      {%- for i in (1..4) -%}
        {%- assign name_key = 'styling_' | append: i | append: '_name' -%}
        {%- assign text_key = 'styling_' | append: i | append: '_text' -%}
        {%- assign method_name = section.settings[name_key] -%}
        {%- assign method_text = section.settings[text_key] -%}
        {%- if method_name != blank -%}
          <li class="styling-item">
            <h3 class="styling-item__name">{{ method_name }}</h3>
            <p class="styling-item__text">{{ method_text }}</p>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>

    {%- if section.settings.styling_cta_label != blank -%}
      <a
        href="{{ section.settings.styling_cta_url | default: routes.collections_url }}"
        class="modal-cta"
      >
        <span>{{ section.settings.styling_cta_label }}</span>
      </a>
    {%- endif -%}
  </div>


  <!-- ── MODAL: CONTACT ── -->
  <div
    class="modal"
    id="modal-contact"
    data-modal-id="contact"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-contact-title"
  >
    <button class="modal-close" aria-label="Close">&times;</button>
    <p class="modal-eyebrow">{{ section.settings.contact_eyebrow }}</p>
    <h2 class="modal-title" id="modal-contact-title">{{ section.settings.contact_title }}</h2>
    <div class="modal-body">{{ section.settings.contact_body }}</div>
    {%- if section.settings.contact_email != blank -%}
      <a
        href="mailto:{{ section.settings.contact_email }}"
        class="modal-cta modal-cta--ghost"
      >
        <span>{{ section.settings.contact_email }}</span>
      </a>
    {%- endif -%}
  </div>

</div><!-- /entry -->


{% schema %}
{
  "name": "Entry Page",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Recommended: 2400px wide, landscape. A beautiful fabric or silk photo works best. If left blank, the gradient background is used."
    },
    {
      "type": "header",
      "content": "Entry Page"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "quietly refined silk"
    },
    {
      "type": "header",
      "content": "Our Story modal"
    },
    {
      "type": "text",
      "id": "story_eyebrow",
      "label": "Eyebrow label",
      "default": "Our Philosophy"
    },
    {
      "type": "text",
      "id": "story_title",
      "label": "Title",
      "default": "Where craft meets comfort"
    },
    {
      "type": "richtext",
      "id": "story_body",
      "label": "Body",
      "default": "<p>At Soie & Forme, we believe the finest things in life belong in your everyday. Inspired by China's centuries-old tradition of silk craftsmanship, we source and curate natural fibre products — from lustrous mulberry silk to breathable linen — each chosen for the quality of its making and the comfort it brings.</p>"
    },
    {
      "type": "text",
      "id": "story_cta_label",
      "label": "Button label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "story_cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Styling Inspo modal"
    },
    {
      "type": "text",
      "id": "styling_eyebrow",
      "label": "Eyebrow label",
      "default": "How to Wear"
    },
    {
      "type": "text",
      "id": "styling_title",
      "label": "Title",
      "default": "Four ways to wear a square"
    },
    {
      "type": "richtext",
      "id": "styling_intro",
      "label": "Intro",
      "default": "<p>One square of silk is never only one thing. These are the four we return to most — each takes under a minute, and none of them need a pin.</p>"
    },
    {
      "type": "text",
      "id": "styling_1_name",
      "label": "Method 1 — name",
      "default": "The Neck Knot"
    },
    {
      "type": "textarea",
      "id": "styling_1_text",
      "label": "Method 1 — how-to",
      "default": "Fold the square corner to corner, then roll it down into a soft band. Wrap once around the neck and tie a loose knot off to one side. Leave the tails uneven — it reads more relaxed than a centred bow."
    },
    {
      "type": "text",
      "id": "styling_2_name",
      "label": "Method 2 — name",
      "default": "The Bandeau"
    },
    {
      "type": "textarea",
      "id": "styling_2_text",
      "label": "Method 2 — how-to",
      "default": "Fold to a band roughly two fingers wide. Lay it across the crown of the head and tie at the nape, underneath the hair. Tuck the ends up and out of sight for a clean line."
    },
    {
      "type": "text",
      "id": "styling_3_name",
      "label": "Method 3 — name",
      "default": "The Handle Wrap"
    },
    {
      "type": "textarea",
      "id": "styling_3_text",
      "label": "Method 3 — how-to",
      "default": "Fold into a narrow strip and wind it around the base of a bag handle, overlapping as you go. Finish with a small knot and let one tail fall. It softens a hard handle and carries colour where you need it."
    },
    {
      "type": "text",
      "id": "styling_4_name",
      "label": "Method 4 — name",
      "default": "The Shoulder Drape"
    },
    {
      "type": "textarea",
      "id": "styling_4_text",
      "label": "Method 4 — how-to",
      "default": "Open the square fully and lay it flat across one shoulder, points falling front and back. Belt it at the waist over a plain shirt or fine knit. The quietest way to wear the whole print."
    },
    {
      "type": "text",
      "id": "styling_cta_label",
      "label": "Button label",
      "default": "Shop the scarves"
    },
    {
      "type": "url",
      "id": "styling_cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Contact modal"
    },
    {
      "type": "text",
      "id": "contact_eyebrow",
      "label": "Eyebrow label",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Title",
      "default": "We'd love to hear from you"
    },
    {
      "type": "richtext",
      "id": "contact_body",
      "label": "Body",
      "default": "<p>Whether you have a question about an order, a bespoke enquiry, or simply want to know more about our materials — reach out and we'll get back to you within one business day.</p>"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email address",
      "default": "hello@soieetforme.com"
    }
  ],
  "presets": [
    {
      "name": "Entry Page"
    }
  ]
}
{% endschema %}
