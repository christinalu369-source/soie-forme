{% comment %}
  Forme by Soie — the side page. Renders the same story engine as the homepage
  via snippets/silk-story.liquid, with its own blocks and its own side tab
  pointing back to Soie & Forme.
{% endcomment %}
{% render 'silk-story', section: section %}

{% schema %}
{
  "name": "Forme Story",
  "tag": "div",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_filmstrip",
      "label": "Show progress filmstrip",
      "default": true
    },
    {
      "type": "header",
      "content": "Sister site"
    },
    {
      "type": "text",
      "id": "sidetab_label",
      "label": "Side tab label",
      "default": "Soie & Forme"
    },
    {
      "type": "select",
      "id": "sidetab_side",
      "label": "Which edge",
      "options": [
        {
          "value": "right",
          "label": "Right — swipe left to go there"
        },
        {
          "value": "left",
          "label": "Left — swipe right to go back"
        }
      ],
      "default": "left"
    },
    {
      "type": "url",
      "id": "sidetab_url",
      "label": "Side tab link",
      "info": "Leave blank to hide the tab entirely."
    },
    {
      "type": "checkbox",
      "id": "sidetab_swipe",
      "label": "Also open it on a left swipe",
      "info": "Touch devices only. Swipes starting at the very edge are ignored so the browser's back gesture still works.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "hero",
      "name": "Cover screen (cinematic)",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Soie & Forme"
        },
        {
          "type": "richtext",
          "id": "mark",
          "label": "Headline",
          "info": "Use italics for the accent word. Two paragraphs give the two-line break.",
          "default": "<p>A story,</p><p>in <em>silk</em></p>"
        },
        {
          "type": "text",
          "id": "sub",
          "label": "Subtitle",
          "default": "Mulberry silk, made to move. Watch how it drapes, knots, and catches the light."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Shop the collection"
        },
        {
          "type": "select",
          "id": "cta_action",
          "label": "Button opens",
          "options": [
            {
              "value": "gallery",
              "label": "A photo collage"
            },
            {
              "value": "scroll",
              "label": "A scene in this story"
            },
            {
              "value": "link",
              "label": "A link"
            }
          ],
          "default": "gallery"
        },
        {
          "type": "range",
          "id": "cta_scene",
          "label": "Scroll to scene number",
          "info": "Counting the cover as 1. Only used when the button goes to a scene.",
          "min": 2,
          "max": 12,
          "step": 1,
          "default": 2
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button link",
          "info": "Only used when the button goes to a link."
        },
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover photo",
          "info": "Full-bleed behind the type. Recommended 2400px wide. Without one, the colour wash below is used."
        },
        {
          "type": "color",
          "id": "color_from",
          "label": "Fallback wash — from",
          "default": "#E7C9D0"
        },
        {
          "type": "color",
          "id": "color_to",
          "label": "Fallback wash — to",
          "default": "#7A4A3C"
        },
        {
          "type": "checkbox",
          "id": "show_side_hint",
          "label": "Show the sideways cue to the sister site",
          "info": "Uses the Sister site link in this section's settings.",
          "default": true
        },
        {
          "type": "header",
          "content": "Photo collage"
        },
        {
          "type": "text",
          "id": "gallery_eyebrow",
          "label": "Lightbox eyebrow",
          "default": "How to Wear"
        },
        {
          "type": "text",
          "id": "gallery_title",
          "label": "Lightbox title",
          "default": "Ways to wear a square"
        },
        {
          "type": "image_picker",
          "id": "gallery_1",
          "label": "Photo 1"
        },
        {
          "type": "text",
          "id": "gallery_1_caption",
          "label": "Photo 1 caption"
        },
        {
          "type": "image_picker",
          "id": "gallery_2",
          "label": "Photo 2"
        },
        {
          "type": "text",
          "id": "gallery_2_caption",
          "label": "Photo 2 caption"
        },
        {
          "type": "image_picker",
          "id": "gallery_3",
          "label": "Photo 3"
        },
        {
          "type": "text",
          "id": "gallery_3_caption",
          "label": "Photo 3 caption"
        },
        {
          "type": "image_picker",
          "id": "gallery_4",
          "label": "Photo 4"
        },
        {
          "type": "text",
          "id": "gallery_4_caption",
          "label": "Photo 4 caption"
        },
        {
          "type": "image_picker",
          "id": "gallery_5",
          "label": "Photo 5"
        },
        {
          "type": "text",
          "id": "gallery_5_caption",
          "label": "Photo 5 caption"
        },
        {
          "type": "image_picker",
          "id": "gallery_6",
          "label": "Photo 6"
        },
        {
          "type": "text",
          "id": "gallery_6_caption",
          "label": "Photo 6 caption"
        }
      ]
    },
    {
      "type": "card",
      "name": "Title / closing card",
      "settings": [
        {
          "type": "richtext",
          "id": "mark",
          "label": "Headline",
          "info": "Use italics for the olive accent word.",
          "default": "<p>A story,</p><p>in <em>silk</em></p>"
        },
        {
          "type": "text",
          "id": "sub",
          "label": "Subtitle",
          "default": "Keep scrolling. Each scene fades to the next."
        },
        {
          "type": "header",
          "content": "Closing card only"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "info": "Leave blank on the opening card to show the scroll hint instead."
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button link"
        },
        {
          "type": "text",
          "id": "link_1_label",
          "label": "Secondary link 1 label"
        },
        {
          "type": "url",
          "id": "link_1_url",
          "label": "Secondary link 1 URL"
        },
        {
          "type": "text",
          "id": "link_2_label",
          "label": "Secondary link 2 label"
        },
        {
          "type": "url",
          "id": "link_2_url",
          "label": "Secondary link 2 URL"
        }
      ]
    },
    {
      "type": "scene",
      "name": "Story scene",
      "settings": [
        {
          "type": "text",
          "id": "chapter",
          "label": "Chapter label",
          "default": "Chapter I"
        },
        {
          "type": "text",
          "id": "line",
          "label": "Headline",
          "default": "It begins as thread."
        },
        {
          "type": "textarea",
          "id": "note",
          "label": "Caption",
          "default": "Raw mulberry silk, before it is anything at all."
        },
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Scene video",
          "info": "Silent, looping, full-bleed. Plays only while its scene is on screen. Keep it short (5-15s) — it is decorative, so put nothing essential in it."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Scene photo",
          "info": "Used on its own, or as the video's poster frame while it loads. Recommended 2000px wide."
        },
        {
          "type": "color",
          "id": "color_from",
          "label": "Fallback wash — from",
          "default": "#EFEADF"
        },
        {
          "type": "color",
          "id": "color_to",
          "label": "Fallback wash — to",
          "default": "#A49A80"
        },
        {
          "type": "header",
          "content": "Photo collage (optional)"
        },
        {
          "type": "text",
          "id": "gallery_label",
          "label": "Button label",
          "info": "Shows a button that opens a lightbox of stills. Leave blank to hide it."
        },
        {
          "type": "text",
          "id": "gallery_eyebrow",
          "label": "Lightbox eyebrow",
          "info": "Defaults to the chapter label."
        },
        {
          "type": "text",
          "id": "gallery_title",
          "label": "Lightbox title",
          "info": "Defaults to the scene headline."
        },
        {
          "type": "image_picker",
          "id": "gallery_1",
          "label": "Photo 1"
        },
        {
          "type": "text",
          "id": "gallery_1_caption",
          "label": "Photo 1 caption"
        },
        {
          "type": "image_picker",
          "id": "gallery_2",
          "label": "Photo 2"
        },
        {
          "type": "text",
          "id": "gallery_2_caption",
          "label": "Photo 2 caption"
        },
        {
          "type": "image_picker",
          "id": "gallery_3",
          "label": "Photo 3"
        },
        {
          "type": "text",
          "id": "gallery_3_caption",
          "label": "Photo 3 caption"
        },
        {
          "type": "image_picker",
          "id": "gallery_4",
          "label": "Photo 4"
        },
        {
          "type": "text",
          "id": "gallery_4_caption",
          "label": "Photo 4 caption"
        },
        {
          "type": "image_picker",
          "id": "gallery_5",
          "label": "Photo 5"
        },
        {
          "type": "text",
          "id": "gallery_5_caption",
          "label": "Photo 5 caption"
        },
        {
          "type": "image_picker",
          "id": "gallery_6",
          "label": "Photo 6"
        },
        {
          "type": "text",
          "id": "gallery_6_caption",
          "label": "Photo 6 caption"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Forme Story"
    }
  ]
}
{% endschema %}
